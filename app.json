{
  "expo": {
    "name": "Menu Semanal",
    "slug": "menu-semanal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.svg",
    "scheme": "menu-semanal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.svg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F",
        "foregroundImage": "./assets/images/icon.svg",
        "backgroundImage": "./assets/images/icon.svg",
        "monochromeImage": "./assets/images/icon.svg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D6A4F",
          "image": "./assets/images/icon.svg",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}